class Solution {
    public boolean isValidSudoku(char[][] board) {
        //any n*n sudoku
        //int index = (r/k)*k + (c/k);
        //k = sqrt of board.length
       //row -- hashset -- 9
       //col - 9
       //box - 9 
       /*
       if duplicate 
       set.conatins not valid
       else valid
       */
       //--  approach 1
        HashSet<Character>[] row = new HashSet[board.length];
        HashSet<Character>[] col = new HashSet[board.length];
        HashSet<Character>[] box = new HashSet[board.length];

        for(int i=0;i<=board.length-1;i++){
             box[i] = new HashSet<Character>();
             row[i] = new HashSet<Character>();
             col[i] = new HashSet<Character>();
        }
        for(int r=0;r<=board.length-1;r++){
        for(int c=0;c<=board[r].length-1;c++){
            int index = (r/3)*3+(c/3); // if from 0
            // if from 1 then (r/3) + 3 + (c/3)
            char val = board[r][c];
            if(val == '.'){
                continue;
            }
            if(row[r].contains(val)){
                return false;
            }
              else{
              row[r].add(val);
             }
             if(col[c].contains(val)){
                return false;
             }
             else{
                col[c].add(val);
             }
             if(box[index].contains(val)){
                return false;
             }
             else{
                box[index].add(val);
             }
         }
    }
    return true;
    }
}
